# Cloudflare Pages response headers.

# Site-wide security and privacy headers.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted build assets never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand assets and fonts change rarely.
/brand/*
  Cache-Control: public, max-age=604800
/icons/*
  Cache-Control: public, max-age=604800
/og/*
  Cache-Control: public, max-age=604800

# The dev room is a local-only prototype. This stricter policy makes the "no network requests" claim enforceable:
# connect-src 'none' blocks fetch/XHR/WebSocket from the page, and form-action 'none' blocks form posts.
# (Applied in addition to the site-wide policy; the browser enforces both.)
/deal-room
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
/deal-room/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
